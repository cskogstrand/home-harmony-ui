HOME_ASSISTANT_URL=http://homeassistant.local
HOME_ASSISTANT_TOKEN=replace-with-a-home-assistant-long-lived-access-token
DASHBOARD_PASSWORD=replace-with-a-unique-password
# Trusted local networks only: true skips login; DASHBOARD_PASSWORD can be empty.
DASHBOARD_AUTH_DISABLED=false
# Optional read-only timetable API key (32+ characters); empty disables key access.
TIMETABLE_API_KEY=
# Deprecated URLs containing the key; disable after migrating to header auth.
TIMETABLE_LEGACY_URL_KEY=true
# Native Node / Vite only; Docker Compose mounts ./data at /data.
DATA_DIR=./data
PORT=8099
