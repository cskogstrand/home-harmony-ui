      "css": ".ds-field-label{display:flex;flex-direction:column;gap:8px;font:400 .9375rem/1.5 var(--font-ui,-apple-system,BlinkMacSystemFont,\"Public Sans\",sans-serif);color:hsl(var(--foreground, 218 30% 16%))}.ds-field{min-height:48px;border:1px solid hsl(var(--input, 217 16% 55%));background:hsl(var(--background, 218 32% 95%));color:hsl(var(--foreground, 218 30% 16%));border-radius:14px;padding:9px 12px;font:inherit;caret-color:hsl(var(--primary, 213 92% 39%))}.ds-field::placeholder{color:hsl(var(--muted-foreground, 218 14% 40%));opacity:1}.ds-field:focus-visible{outline:2px solid hsl(var(--primary, 213 92% 39%));outline-offset:2px}.ds-field:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
