    {
      "name": "Main navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Deep evergreen navigation with a sage active route. Dark mode adds a thin sage outline and a quieter selection. Shown in normal flow for the preview.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#today\" aria-current=\"page\">Today</a><a href=\"#week\">Our week</a><a href=\"#lists\">Lists</a></nav>",
      "css": ".ds-nav{display:flex;gap:.5rem;padding:.5rem;border:1px solid hsl(var(--nav-border,164 35% 9%));border-radius:16px;background:hsl(var(--nav-background, 164 35% 9%))}.ds-nav a{flex:1;display:flex;align-items:center;justify-content:center;min-height:56px;padding:.85rem .6rem;border-radius:10px;color:hsl(var(--nav-muted, 142 17% 76%));font:500 .9375rem/1.5 'Public Sans',sans-serif;text-decoration:none}.ds-nav a:hover{color:hsl(var(--nav-foreground, 130 25% 94%));background:hsl(var(--nav-foreground,130 25% 94%) / .1)}.ds-nav a[aria-current]{background:hsl(var(--nav-active, 143 25% 78%));color:hsl(var(--nav-background, 164 35% 9%))}.ds-nav a:focus-visible{outline:2px solid hsl(var(--nav-active, 143 25% 78%));outline-offset:3px}"
    },
    {
      "name": "Filter chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Outlined filter with its selected state alongside.",
      "html": "<div class=\"ds-chip-row\"><button class=\"ds-chip\" type=\"button\" aria-pressed=\"false\">All</button><button class=\"ds-chip\" type=\"button\" aria-pressed=\"true\">Selected</button></div>",
      "css": ".ds-chip-row{display:flex;gap:9px;flex-wrap:wrap}.ds-chip{min-height:48px;padding:6px 17px;border:1px solid hsl(var(--border, 128.6 11.5% 76.1%));border-radius:50px;background:transparent;color:hsl(var(--muted-foreground, 152.7 11.7% 36.9%));font:400 .875rem/1.5 'Public Sans',sans-serif;cursor:pointer}.ds-chip[aria-pressed=\"true\"]{background:hsl(var(--primary, 156.7 33.8% 31.4%));color:hsl(var(--primary-foreground, 0.0 0.0% 100.0%));border-color:hsl(var(--primary, 156.7 33.8% 31.4%))}.ds-chip:focus-visible{outline:2px solid hsl(var(--primary, 156.7 33.8% 31.4%));outline-offset:2px}"
    },
    {
      "name": "Work panel",
      "kind": "card",
      "refersTo": "work-panel",
      "description": "Flat card surface with a title and a reachable action.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-heading\"><h2>Lists</h2><a href=\"#lists\">Open lists</a></div><p>Items appear here.</p></section>",
      "css": ".ds-panel{min-width:0;padding:var(--panel-space,1.5rem);border:1px solid hsl(var(--border,128.6 11.5% 76.1%) / .7);border-radius:14px;background:hsl(var(--card, 72.0 26.3% 96.3%));color:hsl(var(--foreground, 169.3 30.4% 18.0%));font-family:'Public Sans',sans-serif}.ds-panel-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem}.ds-panel h2{margin:0;font-size:1.25rem;font-weight:600;line-height:1.35;letter-spacing:-.02em}.ds-panel a{display:inline-flex;align-items:center;min-height:48px;color:hsl(var(--primary, 156.7 33.8% 31.4%));font-size:.875rem;font-weight:500;text-decoration:none}.ds-panel a:hover{text-decoration:underline;text-underline-offset:4px}.ds-panel a:focus-visible{outline:2px solid hsl(var(--primary, 156.7 33.8% 31.4%));outline-offset:2px}.ds-panel p{margin:0;color:hsl(var(--muted-foreground, 152.7 11.7% 36.9%));font-size:.9375rem;line-height:1.7}"
    }
