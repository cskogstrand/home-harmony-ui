      "description": "Labeled input used in planner and quick-add forms.",
      "html": "<label class=\"ds-field-label\">Title<input class=\"ds-field\" placeholder=\"Add a title\"></label>",
      "css": ".ds-field-label{display:flex;flex-direction:column;gap:8px;font:400 .9375rem/1.5 'Public Sans',sans-serif;color:hsl(var(--foreground, 169.3 30.4% 18.0%))}.ds-field{min-height:48px;border:1px solid hsl(var(--input, 137.1 9.9% 58.2%));background:hsl(var(--background, 130.0 14.3% 91.8%));color:hsl(var(--foreground, 169.3 30.4% 18.0%));border-radius:10px;padding:9px 12px;font:inherit;caret-color:hsl(var(--primary, 156.7 33.8% 31.4%))}.ds-field::placeholder{color:hsl(var(--muted-foreground, 152.7 11.7% 36.9%));opacity:1}.ds-field:focus-visible{outline:2px solid hsl(var(--primary, 156.7 33.8% 31.4%));outline-offset:2px}.ds-field:disabled{opacity:.5;cursor:not-allowed}"
