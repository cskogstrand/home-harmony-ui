  "narrative": {
    "northStar": "Library wayfinding",
    "overview": "Library wayfinding gives Afterglow a calm, legible system for shared household tasks. Green-gray ground, near-white work surfaces and dark green ink make content easy to scan. Deep evergreen navigation supplies a stable point of orientation.\n\nThe interface uses aligned rows, clear dividers and restrained corners. Public Sans carries headings, controls and readings with consistent letterforms. Density changes with the available space; touch actions, readable labels and explicit states remain visible.",
    "keyCharacteristics": [
      "Tonal surfaces and evergreen wayfinding.",
      "A single self-hosted sans family with a clear size hierarchy.",
      "Aligned schedules, divided lists and visible current location.",
      "Responsive density with generous portrait touch controls."
    ],
    "rules": [
      {
        "name": "Meaning Before Color",
        "body": "Pair selected, offline, loading, error and completion colors with text, icons or semantic state; color is never the only cue.",
        "section": "colors"
      },
      {
        "name": "Read Before Decoration",
        "body": "Use the existing sentence-case heading hierarchy and concise action labels. Give content the strongest typographic emphasis.",
        "section": "typography"
      },
      {
        "name": "Flat Work Surface",
        "body": "Keep recurring work panels flat. Use borders, tonal changes and spacing to separate content; reserve elevation for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic CSS colors so the dark theme follows the same roles.",
      "Do keep the portrait reading scale and large list, event and navigation targets.",
      "Do preserve visible focus, text wrapping, scrollable overflow and safe-area clearance.",
      "Do show unavailable, pending and empty states distinctly.",
      "Do keep examples fictional and household data outside committed design assets."
    ],
    "donts": [
      "Don't shrink or hide task content to force a tall screen into one viewport.",
      "Don't encode a person, device state or selected route through color alone.",
      "Don't add decorative headings, gradients or elevation to the recurring work panels.",
      "Don't turn a timetable preview into a cropped substitute for the full, pageable view."
    ]
  }
}
