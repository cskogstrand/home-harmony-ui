        "purpose": "Time only; tabular numerals, responsive size."
      },
      "headline": {
        "displayName": "Page headline",
        "purpose": "Sentence-case page titles."
      },
      "title": {
        "displayName": "Panel title",
        "purpose": "Shared panel headings; 1.4rem on large portrait screens."
      },
      "body": {
        "displayName": "Supporting copy",
        "purpose": "Readable descriptions and supporting notes."
      },
      "label": {
        "displayName": "Control label",
        "purpose": "Medium-weight shared button labels."
      }
    },
    "shadows": [
      {
        "name": "home-shadow-sm",
        "value": "0 2px 6px hsl(220 40% 18% / .04)",
        "purpose": "Low elevation for existing shared primitives; recurring work panels remain flat."
      },
      {
        "name": "home-shadow-md",
        "value": "0 8px 24px hsl(220 40% 18% / .09)",
        "purpose": "Medium elevation for existing shared primitives."
      },
      {
        "name": "home-shadow-lg",
        "value": "0 20px 60px hsl(220 40% 12% / .18)",
        "purpose": "Elevated-surface token."
      },
      {
        "name": "glass-surface",
        "value": "inset 0 1px 0 hsl(var(--glass-highlight)), inset 0 -1px 0 hsl(var(--glass-shade)), 0 8px 32px hsl(var(--glass-shade))",
        "purpose": "Shared dock and menu edge light and elevation; removed for reduced transparency, increased contrast and forced colors."
      },
      {
        "name": "glass-header",
        "value": "inset 0 1px 0 hsl(var(--glass-highlight)), 0 3px 12px hsl(var(--glass-shade))",
        "purpose": "Quieter shadow for the home selector and settings control."
      }
    ],
    "motion": [
      {
        "name": "ease-out",
        "value": "cubic-bezier(0.23, 1, 0.32, 1)",
        "purpose": "Shared pointer press, surface and list entry easing."
      },
      {
        "name": "ease-in-out",
        "value": "cubic-bezier(0.77, 0, 0.175, 1)",
        "purpose": "Switch-thumb translation easing."
      },
      {
        "name": "press-feedback",
        "value": "120ms",
        "purpose": "Pointer press opacity and scale(.97); scale is disabled for reduced motion."
      },
      {
        "name": "switch-thumb",
        "value": "160ms",
        "purpose": "Pointer switch translation when motion is allowed."
      },
      {
        "name": "composer-entry",
        "value": "160ms",
        "purpose": "Pointer list-composer and suggestion entry."
      },
      {
        "name": "menu-surface",
        "value": "180ms",
        "purpose": "Pointer menu entry and exit from the trigger origin."
      },
      {
        "name": "dialog-surface",
        "value": "240ms",
        "purpose": "Pointer dialog entry and exit; opacity and scale(.96)."
      },
      {
        "name": "task-check-draw",
        "value": "200ms",
        "purpose": "Pointer completion check and text-color transition when motion is allowed."
      },
      {
        "name": "list-reflow",
        "value": "240ms cubic-bezier(.23, 1, .32, 1)",
        "purpose": "List entry and reflow; reduced motion uses zero duration."
