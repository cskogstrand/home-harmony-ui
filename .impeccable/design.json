  "components": [
    {
      "name": "Button primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared Button primary variant.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Save changes</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.75rem;padding:.5rem 1rem;border-radius:999px;font:500 .875rem/1.25rem var(--font-ui,-apple-system,BlinkMacSystemFont,\"Public Sans\",sans-serif);cursor:pointer;transition:color .15s,background-color .15s,border-color .15s;background:hsl(var(--primary, 213 92% 39%));color:hsl(var(--primary-foreground, 0 0% 100%));border:0;}.ds-button-primary:hover{background:hsl(var(--primary, 213 92% 39%) / .9);}.ds-button-primary:focus-visible{outline:2px solid hsl(var(--primary, 213 92% 39%));outline-offset:2px}.ds-button-primary:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Button destructive",
